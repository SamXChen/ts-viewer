{
  "name": "ts-viewer",
  "private": true,
  "version": "0.0.1",
  "author": "samxchen",
  "license": "MIT",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "turbo run build",
    "validate": "tsx ./tests/validate.ts",
    "test": "tsx ./tests/test.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck && tsc -p tests/tsconfig.json",
    "prerelease": "pnpm --filter ts-viewer-extension exec npm version patch",
    "package": "pnpm --filter ts-viewer-extension package",
    "release": "pnpm --filter ts-viewer-extension publish --no-git-checks"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/node": "24.13.3",
    "@types/vscode": "1.125.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
